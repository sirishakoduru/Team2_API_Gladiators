  "PostRequest":[
		  
		{
		      "testcaseName": "Add New Program",
		      "endpoint": "/saveprogram",
		      "statusmessage": "Created",
		      "contentType": "application/json",
		      "programRequest": {
		        "programDescription": "Test Program",
		        "programName": "RestAssuredTestFour",
		        "programStatus": "Active"
		      }
		    },
			
			{
					      "testcaseName": "Invalid Token",
					      "endpoint": "/saveprogram",
					      "statusmessage": "Unauthorized",
					      "contentType": "application/json",
					      "programRequest": {
					        "programDescription": "Test Program",
					        "programName": "InvalidTokenProgram",
					        "programStatus": "Active"
					      }
					    },					  

					    {
					      "testcaseName": "Admin creates a program with already existing program name",
					      "endpoint": "/saveprogram",
					      "statusmessage": "Bad Request",
					      "contentType": "application/json",
					      "programRequest": {
					        "programDescription": "Test Program",
					        "programName": "RestAssuredTestOne",
					        "programStatus": "Active"
					      }
					    },

					    {
					      "testcaseName": "Admin creates a program with trailing space in program name",
					      "endpoint": "/saveprogram",
					      "statusmessage": "Bad Request",
					      "contentType": "application/json",
					      "programRequest": {
					        "programDescription": "Test Program",
					        "programName": "TestProgram ",
					        "programStatus": "Active"
					      }
					    },

					    {
					      "testcaseName": "Admin creates a program with only numbers in program name",
					      "endpoint": "/saveprogram",
					      "statusmessage": "Bad Request",
					      "contentType": "application/json",
					      "programRequest": {
					        "programDescription": "Test Program",
					        "programName": "123456",
					        "programStatus": "Active"
					      }
					    },

					    {
					      "testcaseName": "Admin creates a program with invalid status keyword",
					      "endpoint": "/saveprogram",
					      "statusmessage": "Bad Request",
					      "contentType": "application/json",
					      "programRequest": {
					        "programDescription": "Test Program",
					        "programName": "InvalidStatusProgram",
					        "programStatus": "InvalidStatus"
					      }
					    },

					    {
					      "testcaseName": "Admin creates a program without Program name",
					      "endpoint": "/saveprogram",
					      "statusmessage": "Bad Request",
					      "contentType": "application/json",
					      "programRequest": {
					        "programDescription": "Test Program",
					        "programName": "",
					        "programStatus": "Active"
					      }
					    },

					    {
					      "testcaseName": "Admin creates a program with Program name length less than desired length",
					      "endpoint": "/saveprogram",
					      "statusmessage": "Bad Request",
					      "contentType": "application/json",
					      "programRequest": {
					        "programDescription": "Test Program",
					        "programName": "Abc",
					        "programStatus": "Active"
					      }
					    },

					    {
					      "testcaseName": "Admin creates a program with empty payload",
					      "endpoint": "/saveprogram",
					      "statusmessage": "Bad Request",
					      "contentType": "application/json",
					      "programRequest": {
					        "programDescription": "",
					        "programName": "",
					        "programStatus": ""
					      }
					    },

					    {
					      "testcaseName": "Admin creates a program with alpha & special char in program description",
					      "endpoint": "/saveprogram",
					      "statusmessage": "Bad Request",
					      "contentType": "application/json",
					      "programRequest": {
					        "programDescription": "Test@#$%Description",
					        "programName": "SpecialDescProgram",
					        "programStatus": "Active"
					      }
					    },

					    {
					      "testcaseName": "Admin creates a program with program description length more than desired length",
					      "endpoint": "/saveprogram",
					      "statusmessage": "Bad Request",
					      "contentType": "application/json",
					      "programRequest": {
					        "programDescription": "This description is definitely more than twenty five characters",
					        "programName": "LongDescriptionProgram",
					        "programStatus": "Active"
					      }
					    },
						{
						  "testcaseName": "Admin creates a program with program name length between 4 and 25 characters",
						  "endpoint": "/saveprogram",
						  "statusmessage": "Created",
						  "contentType": "application/json",
						  "programRequest": {
						    "programDescription": "Test Program",
						    "programName": "ValidProgramName",
						    "programStatus": "Active"
						  }
						},
						{
						  "testcaseName": "Admin creates a program with program description length between 4 and 25 characters",
						  "endpoint": "/saveprogram",
						  "statusmessage": "Created",
						  "contentType": "application/json",
						  "programRequest": {
						    "programDescription": "Test Description",
						    "programName": "ValidProgram",
						    "programStatus": "Active"
						  }
						}						
						

					  
									
