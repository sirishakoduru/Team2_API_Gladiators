				    "programName": "Updated Program One",
				    "programDescription": "Update Test Program",
				    "programStatus": "Active"
				  },
				  "expectedStatusCode": 401
				},
				
				
				{
				    "testcaseName": "Admin updates a program with valid program Name",
				    "method": "PUT",
				    "endpoint": "/putprogram/{programName}",
				    "contentType": "application/json",
				    "programRequest": {
				      "programName": "Updated Program One",
				      "programDescription": "Update Test Program",
				      "programStatus": "Active"
				    },
				    "expectedStatusCode": 200
				  },
				  {
				    "testcaseName": "Admin updates a program with invalid program Name",
				    "method": "PUT",
				    "endpoint": "/putprogram/999",
				    "contentType": "application/json",
				    "programRequest": {
				      "programName": "Updated Program One",
				      "programDescription": "Update Test Program",
				      "programStatus": "Active"
				    },
				    "expectedStatusCode": 404
				  },
				  {
				    "testcaseName": "Admin updates a program missing mandatory fields in request body",
				    "method": "PUT",
				    "endpoint": "/putprogram/{programName}",
				    "contentType": "application/json",
				    "programRequest": {
				      "programName": "",
				      "programDescription": "Update Test Program",
				      "programStatus": "Active"
				    },
				    "expectedStatusCode": 400
				  },
				  {
				    "testcaseName": "Admin updates a program with invalid status in request body",
				    "method": "PUT",
				    "endpoint": "/putprogram/{programName}",
				    "contentType": "application/json",
				    "programRequest": {
				      "programName": "Updated Program One",
				      "programDescription": "Update Test Program",
				      "programStatus": "InvalidStatus"
				    },
				    "expectedStatusCode": 400
				  },
				  {
				    "testcaseName": "Admin updates a program with only spl char program Description in request body",
				    "method": "PUT",
				    "endpoint": "/putprogram/{programName}",
				    "contentType": "application/json",
				    "programRequest": {
				      "programName": "Updated Program One",
				      "programDescription": "@#$%^&*",
				      "programStatus": "Active"
				    },
				    "expectedStatusCode": 400
				  },
				  {
				    "testcaseName": "Admin updates a program with valid status",
				    "method": "PUT",
				    "endpoint": "/putprogram/{programName}",
				    "contentType": "application/json",
				    "programRequest": {
				      "programName": "Updated Program One",
				      "programDescription": "Update Test Program",
				      "programStatus": "Inactive"
				    },
				    "expectedStatusCode": 200
				  }
				]
				
