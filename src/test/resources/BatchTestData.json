{
  "BatchTestPrograms": {
    "positiveProgramName": "SDETPositiveBatchProgram",
    "negativeProgramName": "SDETNegativeBatchProgram"
  },
  "PostRequest": [
    {
      "testcaseName": "Admin creates batch with both mandatory and optional fields",
      "method": "POST",
      "endpoint": "/batches",
      "expectedStatusCode": 201,
      "batchRequest": {
        "batchDescription": "Valid Description Both Fields",
        "batchNoOfClasses": 12,
        "batchStatus": "ACTIVE"
      }
    },
    {
      "testcaseName": "Admin creates batch with only mandatory fields",
      "method": "POST",
      "endpoint": "/batches",
      "expectedStatusCode": 201,
      "batchRequest": {
        "batchNoOfClasses": 10,
        "batchStatus": "ACTIVE"
      }
    },
    {
      "testcaseName": "Admin creates batch with a program name that does not match the associated program id",
